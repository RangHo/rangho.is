{
  "name": "rangho.is",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync || echo ''",
    "generate:knowledges": "emacs --init-directory=./.emacs.d --script ./scripts/extract-org-node.el ./src/lib/generated/knowledges.json ./src/data/knowledges/*.org",
    "types": "wrangler types",
    "check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "build": "wrangler types --check && vite build",
    "dev": "vite dev",
    "preview": "pnpm run build && wrangler dev",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "katex": "^0.16.46"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/css": "^0.13.0",
    "@eslint/js": "^9.39.4",
    "@giscus/svelte": "^3.1.0",
    "@iconify-json/simple-icons": "^1.2.82",
    "@iconify-json/tabler": "^1.2.35",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/enhanced-img": "^0.8.5",
    "@sveltejs/kit": "^2.59.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^24.12.4",
    "@unocss/extractor-svelte": "^66.6.8",
    "@unocss/reset": "^66.6.8",
    "eslint": "^9.39.4",
    "eslint-plugin-svelte": "^3.17.1",
    "globals": "^16.5.0",
    "ox-svelte": "^0.4.8",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.8",
    "svelte-meta-tags": "^4.7.0",
    "svelte-preprocess-org": "^0.3.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "unocss": "^66.6.8",
    "vite": "^7.3.3",
    "wrangler": "^4.90.1"
  },
  "packageManager": "pnpm@10.17.1"
}
